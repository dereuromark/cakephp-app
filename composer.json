{
    "name": "cakephp/app",
    "description": "CakePHP skeleton app",
    "license": "MIT",
    "type": "project",
    "homepage": "https://cakephp.org",
    "require": {
        "php": ">=8.4",
        "cakephp/cakephp": "5.3.*",
        "cakephp/migrations": "^5.0.0",
        "cakephp/plugin-installer": "^2.0",
        "friendsofcake/bootstrap-ui": "^5.0"
    },
    "require-dev": {
        "cakephp/bake": "^3.6.0",
        "dereuromark/cakephp-ide-helper": "dev-master",
        "cakephp/debug_kit": "^5.0.0",
        "phpunit/phpunit": "^13.1.1",
        "phpstan/phpstan": "^2.1",
        "php-collective/code-sniffer": "^0.5.5"
    },
    "suggest": {
        "markstory/asset_compress": "An asset compression plugin which provides file concatenation and a flexible filter system for preprocessing and minification."
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "App\\Console\\Installer::postInstall",
        "post-create-project-cmd": "App\\Console\\Installer::postInstall",
        "check": [
            "@test",
            "@cs-check"
        ],
        "assets": [
            "mkdir -p ./webroot/assets",
            "mkdir -p ./webroot/css/webfonts",
            "npm i --lock",
            "cp -R node_modules/* webroot/assets/",
            "cp -R webroot/assets/@fortawesome/fontawesome-free/webfonts/* webroot/css/webfonts"
        ],
        "cs-check": "phpcs --colors --parallel=16 -p",
        "cs-fix": "phpcbf --colors --parallel=16 -p",
        "stan": "phpstan analyze",
        "test": "phpunit --colors=always",
        "setup": "bin/cake generate code_completion && bin/cake generate phpstorm"
    }
}
